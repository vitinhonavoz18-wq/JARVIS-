# ====== FRONTEND (público — vai para o navegador) ======
# Sem estas duas variáveis o app roda em "Modo Local" (dados só neste dispositivo).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Chave pública VAPID para Web Push (gerada com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# ====== SECRETS DAS EDGE FUNCTIONS (NUNCA no frontend) ======
# Configure com: supabase secrets set NOME=valor
# AI_PROVIDER=anthropic            # anthropic | openai
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
# CRON_SECRET=                     # segredo compartilhado entre pg_cron e a função de lembretes
# ELEVENLABS_API_KEY=              # opcional: voz premium
# ELEVENLABS_VOICE_ID=
